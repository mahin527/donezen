# ── Required ────────────────────────────────────────────────────────────────
# MongoDB connection string (config.js throws if missing)
MONGODB_URI=

# Secret used to sign JWTs and to key refresh-token hashing (config.js throws if missing)
JWT_SECRET=

# ── Optional: Gmail OAuth2 (for sending verification emails) ────────────────
# Used by src/services/email.service.js for the OAuth2 transporter
GOOGLE_USER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Defined in config.js but not currently used anywhere
GOOGLE_ACCESS_TOKEN=
